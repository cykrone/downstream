<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the Unity EditMode tests for the sim core under plain NUnit. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- EditMode/Runtime holds Unity-side tests (GPU parity) that need UnityEngine; they run only in the editor. -->
    <Compile Include="../../../Assets/Downstream/Tests/EditMode/**/*.cs" Exclude="../../../Assets/Downstream/Tests/EditMode/Runtime/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Downstream.Core.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
